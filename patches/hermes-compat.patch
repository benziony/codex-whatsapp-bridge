+    elif mode == "raises":
+        context.register_exclusive_inbound_handler("codex_bridge", raises)
+    elif mode == "rejects":
+        context.register_exclusive_inbound_handler("codex_bridge", rejects)
+    elif mode == "sync":
+        context.register_exclusive_inbound_handler(
+            "codex_bridge", lambda _event: True
