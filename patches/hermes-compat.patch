+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("mode", ["missing", "duplicate", "raises", "rejects", "sync"])
+async def test_claimed_chat_fails_closed_when_handler_is_unavailable(
+    monkeypatch, mode
+):
+    runner = _runner()
+    adapter = _Adapter(_claim())
