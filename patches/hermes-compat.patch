+
+@pytest.mark.parametrize(
+    "claim",
+    [
+        None,
+        [],
+        {},
+        {"chat_id": "codex@g.us"},
+        {"handler": "bridge"},
+        {"chat_id": "codex@g.us", "handler": "bridge", "allowed_senders": []},
+    ],
